exports[`chorus tool definitions > paid coordination: with billing on, set_coordination_mode is the paid variant (request_id, payment_txn_id) 1`] = `
{
  "description": "Sets a session's room-message coordination mode ('off', 'observe' or 'assist'). Requires an administrator and the latest session version. Paid when it raises the mode: off → observe 2 credits, off → assist 3, observe → assist 1 (the difference); the same mode, lowering it, and 'off' are free. A raise answers payment_required with what to pay; call again with the same arguments plus payment_txn_id. Pass request_id (idempotency_key is accepted in its place).",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "expected_version": {
        "type": "integer",
      },
      "idempotency_key": {
        "type": "string",
      },
      "mode": {
        "type": "string",
      },
      "payment_txn_id": {
        "type": "string",
      },
      "request_id": {
        "type": "string",
      },
      "session_id": {
        "type": "string",
      },
    },
    "required": [
      "session_id",
      "mode",
      "expected_version",
    ],
    "type": "object",
  },
  "name": "chorus.set_coordination_mode",
  "namespace": "chorus",
  "readWrite": "write",
  "requiredCapability": {
    "action": "administer",
    "resource": {
      "namespace": "chorus",
      "path": [],
    },
  },
  "source": "host",
}
`;
