CHORUS_ENV=production
PORT=18080
PUBLIC_BASE_URL=https://chorus.chorus-app.workers.dev
DATABASE_URL_APP=postgres://chorus_app:CHANGE_ME_APP_PASSWORD@postgres:5432/chorus
CHORUS_SECRETS_KEY=CHANGE_ME_BASE64_32_BYTES
LEASE_DURATION_SECONDS=900
SHAREDNET_BASE_URL=https://www.sharednet.ai
# Read from S1-5 onward; ignored before it.
CHORUS_BILLING=disabled
# Used by docker compose itself (not the api process):
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
CHORUS_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
